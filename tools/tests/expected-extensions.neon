# DRAFT: not wired into builds. See build-notes.md for dependency blockers.
# Profiles describe image tags, not PHP_SAPI. base means neither debug nor cli.
# mbstring exceptions record observations and require review before adoption.
profiles:
	- '8.4'
	- 8.4-cli
	- 8.4-debug
	- '8.5'
	- 8.5-cli
	- 8.5-debug
	- 8.6-rc
	- 8.6-rc-cli
	- 8.6-rc-debug

common:
	- bcmath
	- bz2
	- calendar
	- core
	- ctype
	- curl
	- date
	- dom
	- exif
	- fileinfo
	- filter
	- gd
	- gettext
	- gmp
	- hash
	- iconv
	- intl
	- json
	- libxml
	- mbstring
	- memcached
	- mysqli
	- mysqlnd
	- openssl
	- pcntl
	- pcre
	- pdo
	- pdo_mysql
	- pdo_sqlite
	- phar
	- posix
	- random
	- readline
	- reflection
	- session
	- simplexml
	- soap
	- sockets
	- sodium
	- spl
	- sqlite3
	- standard
	- sysvmsg
	- sysvsem
	- sysvshm
	- tokenizer
	- xml
	- xmlreader
	- xmlwriter
	- xsl
	- zend opcache
	- zip
	- zlib

rules:
	- when: ['>=8.5']
	  add: [lexbor, uri]

	- when: [+debug]
	  add: [xdebug, spx]

# Applied last, only to the exact named profile; never to future stable 8.6.
exceptions:
	8.6-rc:
		remove: [mbstring]
		reason: Observed missing in local PHP 8.6.0RC3; intent is not yet approved.
		removeWhen: Resolve mbstring policy before enabling the inventory check; revisit at 8.6 stable.
	8.6-rc-cli:
		remove: [mbstring]
		reason: Observed missing in local PHP 8.6.0RC3; intent is not yet approved.
		removeWhen: Resolve mbstring policy before enabling the inventory check; revisit at 8.6 stable.
	8.6-rc-debug:
		remove: [mbstring]
		reason: Observed missing in local PHP 8.6.0RC3; intent is not yet approved.
		removeWhen: Resolve mbstring policy before enabling the inventory check; revisit at 8.6 stable.
