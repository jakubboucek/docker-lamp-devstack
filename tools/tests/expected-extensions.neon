# DRAFT: not wired into builds. Parser choice and validation evidence: build-notes.md.
# Profiles describe image tags, not PHP_SAPI. base means neither debug nor cli.
# mbstring is mandatory, including PHP 8.6 RC; current images need repair.
profiles:
	- '8.2'
	- 8.2-cli
	- 8.2-debug
	- '8.3'
	- 8.3-cli
	- 8.3-debug
	- '8.4'
	- 8.4-cli
	- 8.4-debug
	- '8.5'
	- 8.5-cli
	- 8.5-debug
	- 8.6-rc
	- 8.6-rc-cli
	- 8.6-rc-debug

common:
	- bcmath
	- bz2
	- calendar
	- core
	- ctype
	- curl
	- date
	- dom
	- exif
	- fileinfo
	- filter
	- gd
	- gettext
	- gmp
	- hash
	- iconv
	- intl
	- json
	- libxml
	- mbstring
	- memcached
	- mysqli
	- mysqlnd
	- openssl
	- pcntl
	- pcre
	- pdo
	- pdo_mysql
	- pdo_sqlite
	- phar
	- posix
	- random
	- readline
	- reflection
	- session
	- simplexml
	- soap
	- sockets
	- sodium
	- spl
	- sqlite3
	- standard
	- sysvmsg
	- sysvsem
	- sysvshm
	- tokenizer
	- xml
	- xmlreader
	- xmlwriter
	- xsl
	- zend opcache
	- zip
	- zlib

rules:
	- when: ['>=8.5']
	  add: [lexbor, uri]

	- when: [+debug]
	  add: [xdebug, spx]

# Exact-profile exceptions apply last. Missing mbstring is a build defect, not an exception.
exceptions: {}
